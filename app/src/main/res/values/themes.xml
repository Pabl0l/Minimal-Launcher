<resources>
    <style name="Theme.MinimalLauncher" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">@color/white</item>
        <!-- Transiciones manuales via overridePendingTransition -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Dialogo tipo tarjeta iOS: fondo redondeado, tipografia clara -->
    <style name="Theme.MinimalDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/offwhite</item>
        <item name="android:textColorSecondary">@color/gray</item>
        <item name="colorAccent">@color/white</item>
        <item name="android:windowTitleStyle">@style/MinimalDialogTitle</item>
        <item name="android:windowMinWidthMajor">86%</item>
        <item name="android:windowMinWidthMinor">86%</item>
        <item name="buttonBarButtonStyle">@style/MinimalDialogButton</item>
    </style>

    <style name="MinimalDialogTitle" parent="@android:style/TextAppearance.DeviceDefault.DialogWindowTitle">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="MinimalDialogButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Hoja inferior "liquid glass": translucida, anclada abajo, con slide -->
    <style name="Theme.GlassSheet" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimAmount">0.55</item>
        <item name="android:windowAnimationStyle">@style/SheetAnim</item>
        <item name="colorAccent">@color/white</item>
    </style>

    <style name="SheetAnim" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>
</resources>
