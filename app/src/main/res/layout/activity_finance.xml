<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/finance_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="56dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saldo total"
            android:textColor="@color/gray"
            android:textSize="13sp"
            android:letterSpacing="0.06"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/finance_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/white"
            android:textSize="42sp"
            android:letterSpacing="-0.02"
            android:fontFamily="sans-serif-medium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/btn_income"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="＋  Ingreso"
                android:textColor="@color/positive"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/pill_bg_green" />

            <Space
                android:layout_width="14dp"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/btn_expense"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:text="－  Egreso"
                android:textColor="@color/negative"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:background="@drawable/pill_bg_red" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Billeteras"
            android:textColor="@color/gray"
            android:textSize="13sp"
            android:letterSpacing="0.06" />

        <LinearLayout
            android:id="@+id/wallets_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/add_wallet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:text="＋  Añadir billetera"
            android:textColor="@color/gray"
            android:textSize="15sp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/tx_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Movimientos"
            android:textColor="@color/gray"
            android:textSize="13sp"
            android:letterSpacing="0.06" />

        <LinearLayout
            android:id="@+id/tx_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</ScrollView>
